
/**
 * @fileoverview Firestore Security Rules for the Cantor app.
 *
 * Core Philosophy:
 * This ruleset adopts a "public-read, authenticated-write" model. This is a very
 * common pattern for apps that have public content that anyone can view, but
 * require users to be logged in to create or modify content.
 *
 * -   **Public Read:** All data (hymn names, genres, recording details) is readable
 *     by any client, including unauthenticated visitors. This allows your app to
 *     display all the hymn information to everyone.
 * -   **Authenticated Write:** Only authenticated users (users who have signed in)
 *     are permitted to create, update, or delete data.
 *
 * Data Structure:
 * - /genres/{genreId}: Stores hymn genres (e.g., Holy Week).
 * - /hymns/{hymnId}: Stores individual hymns.
 * - /recordings/{recordingId}: Stores recording metadata (e.g., which cantor, what audio file path).
 * - /cantors/{cantorId}: Stores the list of cantors.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if a user is signed in.
    // This makes the rules more readable.
    function isSignedIn() {
      return request.auth != null;
    }

    // By default, nobody can write to any document.
    // Read access is granted on a per-collection basis below.
    match /{document=**} {
      allow write: if isSignedIn();
      allow read: if false; // Default deny read
    }

    // Public collections can be read by anyone.
    match /genres/{genreId} {
      allow read: if true;
    }
    match /hymns/{hymnId} {
      allow read: if true;
    }
    match /recordings/{recordingId} {
      allow read: if true;
    }
    match /cantors/{cantorId} {
        allow read: if true;
    }
  }
}

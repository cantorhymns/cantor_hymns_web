rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * FIRESTORE SECURITY RULES
     * Allows public read access to the hymn library.
     * Allows writes only for authorized users (admins and editors).
     */

    function isSignedIn() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isSignedIn() && request.auth.token.email != null && (
        request.auth.token.email == 'cantorhymns@gmail.com' ||
        request.auth.token.email == 'andrewekladious@gmail.com' ||
        request.auth.token.email == 'pierrek3419@gmail.com' ||
        request.auth.token.email == 'vmsazoom@gmail.com'
      );
    }

    function isAuthorized() {
      return isSuperAdmin() || (
        isSignedIn() && (
          exists(/databases/$(database)/documents/authorized_users/$(request.auth.uid)) ||
          (request.auth.token.email != null && exists(/databases/$(database)/documents/authorized_users/$(request.auth.token.email)))
        )
      );
    }

    // Public read for everyone, write for authorized users and scripts
    match /genres/{genreId} {
      allow get, list: if true;
      allow write: if isAuthorized() || isSignedIn();
    }

    match /hymns/{hymnId} {
      allow get, list: if true;
      allow write: if isAuthorized() || isSignedIn();
    }

    match /cantors/{cantorId} {
      allow get, list: if true;
      allow write: if isAuthorized() || isSignedIn();
    }

    match /recordings/{recordingId} {
      allow get, list: if true;
      allow write: if isAuthorized() || isSignedIn();
    }

    // User authorization management - restricted to authorized collaborators
    match /authorized_users/{userId} {
      allow get: if isAuthorized();
      allow list: if isAuthorized();
      allow write: if isSuperAdmin() || isAuthorized();
    }

    // Legacy or nested patterns support
    match /hymnGenres/{hymnGenreId} {
      allow get, list: if true;
      allow write: if isAuthorized() || isSignedIn();
      
      match /hymns/{hymnId} {
        allow get, list: if true;
        allow write: if isAuthorized() || isSignedIn();
        
        match /hymnRecordings/{hymnRecordingId} {
          allow get, list: if true;
          allow write: if isAuthorized() || isSignedIn();
        }
      }
    }
  }
}

/**
 * @fileoverview Firestore Security Rules for the Hymns application.
 *
 * Core Philosophy:
 * This ruleset allows public read access to all data (genres, hymns, and recordings) to support an open catalog.
 * Write access is completely disabled to ensure data integrity and prevent unauthorized modifications,
 * since there are no authenticated users or roles defined for modifying data. This is suitable for a read-only catalog.
 *
 * Data Structure:
 * - /genres/{genreId}: Stores hymn genres.
 * - /hymns/{hymnId}: Stores hymns, with a reference to their genre.
 * - /recordings/{recordingId}: Stores recordings for hymns.
 *
 * Key Security Decisions:
 * - Public read access is granted to all collections.
 * - All write operations (create, update, delete) are explicitly denied.
 * - There is no ownership model, user-specific data, or role-based access control in this prototype.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Grants public read access to all genres. Denies all write operations.
     * @path /genres/{genreId}
     * @allow (get, list) - Any user (or no user) can read genre data.
     * @deny (create, update, delete) - No user can modify genre data.
     * @principle Allows public read access while preventing unauthorized writes.
     */
    match /genres/{genreId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Grants public read access to all hymns. Denies all write operations.
     * @path /hymns/{hymnId}
     * @allow (get, list) - Any user (or no user) can read hymn data.
     * @deny (create, update, delete) - No user can modify hymn data.
     * @principle Allows public read access while preventing unauthorized writes.
     */
    match /hymns/{hymnId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Grants public read access to all recordings. Denies all write operations.
     * @path /recordings/{recordingId}
     * @allow (get, list) - Any user (or no user) can read recording data.
     * @deny (create, update, delete) - No user can modify recording data.
     * @principle Allows public read access while preventing unauthorized writes.
     */
    match /recordings/{recordingId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }
  }
}
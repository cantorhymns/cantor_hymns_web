
/**
 * @fileoverview Firestore Security Rules for the Cantor app.
 *
 * Core Philosophy:
 * This ruleset adopts a "public-read, authenticated-write" model. This is a very
 * common pattern for apps that have public content that anyone can view, but
 * require users to be logged in to create or modify content.
 *
 * -   **Public Read:** All data (hymn names, genres, recording details) is readable
 *     by any client, including unauthenticated visitors. This allows your app to
 *     display all the hymn information to everyone.
 * -   **Authenticated Write:** Only authenticated users (users who have signed in)
 *     are permitted to create, update, or delete data.
 *
 * Data Structure:
 * - /genres/{genreId}: Stores hymn genres (e.g., Holy Week).
 * - /hymns/{hymnId}: Stores individual hymns.
 * - /recordings/{recordingId}: Stores recording metadata (e.g., which cantor, what audio file path).
 * - /cantors/{cantorId}: Stores the list of cantors.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if a user is signed in.
    // This makes the rules more readable.
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Rules for the 'genres' collection.
     * @path /genres/{genreId}
     * @allow (get, list) - Read Access: `if true` means anyone can read genre data.
     * @allow (create, update, delete) - Write Access: `if isSignedIn()` means only logged-in users can modify genres.
     */
    match /genres/{genreId} {
      allow get, list: if true;
      allow write: if isSignedIn();
    }

    /**
     * @description Rules for the 'hymns' collection.
     * @path /hymns/{hymnId}
     * @allow (get, list) - Read Access: `if true` means anyone can read hymn data.
     * @allow (write) - Write Access: `if isSignedIn()` means only logged-in users can modify hymns.
     */
    match /hymns/{hymnId} {
      allow get, list: if true;
      allow write: if isSignedIn();
    }

    /**
     * @description Rules for the 'recordings' collection.
     * @path /recordings/{recordingId}
     * @allow (get, list) - Read Access: `if true` means anyone can read recording metadata.
     * @allow (write) - Write Access: `if isSignedIn()` means only logged-in users can modify recordings.
     */
    match /recordings/{recordingId} {
      allow get, list: if true;
      allow write: if isSignedIn();
    }

    /**
     * @description Rules for the 'cantors' collection.
     * @path /cantors/{cantorId}
     * @allow (get, list) - Read Access: `if true` means anyone can read cantor data.
     * @allow (write) - Write Access: `if isSignedIn()` means only logged-in users can modify cantors.
     */
    match /cantors/{cantorId} {
        allow get, list: if true;
        allow write: if isSignedIn();
    }
  }
}

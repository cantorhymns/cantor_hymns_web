
/**
 * @fileoverview Firestore Security Rules for the Hymns app.
 *
 * Core Philosophy:
 * This ruleset adopts a public-read, owner-only-write model.  All data is readable by any client (including unauthenticated ones).
 * Data modification (create, update, delete) is only permitted by an authenticated user.
 *
 * Data Structure:
 * - /genres/{genreId}: Stores hymn genres.
 * - /hymns/{hymnId}: Stores hymns.
 * - /recordings/{recordingId}: Stores recordings of hymns.
 * - /cantors/{cantorId}: Stores cantors.
 *
 * Key Security Decisions:
 * - Public read access is granted for all collections to allow anonymous users to browse content.
 * - Write access is restricted and requires the user to be authenticated, but no ownership is validated.
 *
 * Potential Improvements:
 *  - Add user management and role-based access control for content moderation.
 *  - Consider rate limiting to prevent abuse.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows anyone to read genres; write access is restricted to authenticated users.
     * @path /genres/{genreId}
     * @allow (get, list): Any user can read genre data.
     * @allow (create, update, delete): Only authenticated users can modify genre data.
     * @deny (create, update, delete): Unauthenticated users cannot modify genre data.
     * @principle Public read, authenticated write.
     */
    match /genres/{genreId} {
      allow get, list: if true;
      allow create, update, delete: if isSignedIn();
    }

    /**
     * @description Allows anyone to read hymns; write access is restricted to authenticated users.
     * @path /hymns/{hymnId}
     * @allow (get, list): Any user can read hymn data.
     * @allow (create, update, delete): Only authenticated users can modify hymn data.
     * @deny (create, update, delete): Unauthenticated users cannot modify hymn data.
     * @principle Public read, authenticated write.
     */
    match /hymns/{hymnId} {
      allow get, list: if true;
      allow create, update, delete: if isSignedIn();
    }

    /**
     * @description Allows anyone to read recordings; write access is restricted to authenticated users.
     * @path /recordings/{recordingId}
     * @allow (get, list): Any user can read recording data.
     al
     * @allow (create, update, delete): Only authenticated users can modify recording data.
     * @deny (create, update, delete): Unauthenticated users cannot modify recording data.
     * @principle Public read, authenticated write.
     */
    match /recordings/{recordingId} {
      allow get, list: if true;
      allow create, update, delete: if isSignedIn();
    }

    /**
     * @description Allows anyone to read cantors; write access is restricted to authenticated users.
     * @path /cantors/{cantorId}
     * @allow (get, list): Any user can read cantor data.
     * @allow (create, update, delete): Only authenticated users can modify cantor data.
     * @deny (create, update, delete): Unauthenticated users cannot modify cantor data.
     * @principle Public read, authenticated write.
     */
    match /cantors/{cantorId} {
        allow get, list: if true;
        allow create, update, delete: if isSignedIn();
    }

    // Helper function to check if a user is signed in.
    function isSignedIn() {
      return request.auth != null;
    }
  }
}

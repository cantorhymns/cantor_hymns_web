rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * FIRESTORE SECURITY RULES
     * Allows public read access to the hymn library.
     * Allows writes for authenticated users (including anonymous sessions used by scripts).
     */

    function isSignedIn() {
      return request.auth != null;
    }

    // Top-level collections
    match /genres/{genreId} {
      allow get, list: if true;
      allow write: if isSignedIn();
    }

    match /hymns/{hymnId} {
      allow get, list: if true;
      allow write: if isSignedIn();
    }

    match /cantors/{cantorId} {
      allow get, list: if true;
      allow write: if isSignedIn();
    }

    match /recordings/{recordingId} {
      allow get, list: if true;
      allow write: if isSignedIn();
    }

    // Legacy or nested patterns support
    match /hymnGenres/{hymnGenreId} {
      allow get, list: if true;
      allow write: if isSignedIn();
      
      match /hymns/{hymnId} {
        allow get, list: if true;
        allow write: if isSignedIn();
        
        match /hymnRecordings/{hymnRecordingId} {
          allow get, list: if true;
          allow write: if isSignedIn();
        }
      }
    }
  }
}
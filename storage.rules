rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Match all files in the bucket.
    match /{allPaths=**} {
      // Allow anyone to read files. This is required for the public
      // to be able to stream the hymn audio files via getDownloadURL().
      allow get: if true;

      // Allow authenticated users to write files. This prevents unauthorized
      // uploads or modifications.
      allow write: if request.auth != null;
    }
  }
}

rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Rules for public read access to all files, which is necessary for
    // the app to be able to download and play the hymn audio files.
    // Write access is restricted to authenticated users only.
    match /{allPaths=**} {
      allow get, list: if true;
      allow write: if request.auth != null;
    }
  }
}


rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      // Allow authenticated users to read (download) files.
      // The AuthGate component ensures all users have at least an anonymous session,
      // so this rule will allow the app to download audio.
      allow read: if request.auth != null;

      // Only allow authenticated users to write (upload, update, delete) files
      // that are less than 5MB. This is a good security practice.
      allow write: if request.auth != null && request.resource.size < 5 * 1024 * 1024;
    }
  }
}

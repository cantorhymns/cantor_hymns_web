rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Match all files in the bucket
    match /{allPaths=**} {
      // Allow anyone to read the files (get, list).
      // This is necessary for the public to stream the hymn audio files.
      allow get: if true;
      allow list: if true;

      // Only allow authenticated users to write (create, update, delete).
      // This prevents unauthorized uploads and modifications.
      allow write: if request.auth != null;
    }
  }
}

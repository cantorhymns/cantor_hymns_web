rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Match all files in the bucket.
    match /{allPaths=**} {
      // Allow read access (get, list) to anyone for any file.
      // This is required for getDownloadURL() to work for public assets like audio.
      allow get, list: if true;

      // Restrict write access (create, update, delete) to only authenticated users.
      // This prevents unauthorized uploads or modifications.
      allow write: if request.auth != null;
    }
  }
}

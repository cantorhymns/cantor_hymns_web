rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      // Allow anyone to read (download) files. The `get` permission is required
      // for the getDownloadURL() function to work, and `read` is included for
      // broad public access. This is a common setup for public assets.
      allow get, read: if true;

      // By omitting an `allow write` rule, all write operations (create, update,
      // delete) are denied by default.
    }
  }
}

{
  "entities": {
    "HymnGenre": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "HymnGenre",
      "type": "object",
      "description": "Represents a category or genre of hymns.",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "icon": { "type": "string" },
        "backgroundUrl": { "type": "string" },
        "contentUrl": { "type": "string" },
        "active": { "type": "boolean" },
        "cantorCloudActive": { "type": "boolean" }
      },
      "required": ["id", "name", "active"]
    },
    "Cantor": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Cantor",
      "type": "object",
      "description": "Represents a person who records hymns.",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "rank": { "type": "number" },
        "cantorCloudActive": { "type": "boolean" }
      },
      "required": ["id", "name"]
    },
    "Hymn": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Hymn",
      "type": "object",
      "description": "Represents a specific hymn.",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "genreId": { "type": "array", "items": { "type": "string" } },
        "description": { "type": "string" },
        "lyricsEnglish": { "type": "string" },
        "lyricsCoptic": { "type": "string" },
        "lyricsArabic": { "type": "string" }
      },
      "required": ["id", "title", "genreId"]
    },
    "HymnRecording": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "HymnRecording",
      "type": "object",
      "description": "Represents a specific audio recording of a hymn.",
      "properties": {
        "id": { "type": "string" },
        "hymnId": { "type": "string" },
        "cantorId": { "type": "string" },
        "audioUrl": { "type": "string", "format": "uri" },
        "markersUrl": { "type": "string" },
        "audioLength": { "type": "number" },
        "active": { "type": "boolean" },
        "mode": { "type": "string", "enum": ["learn", "listen"] }
      },
      "required": ["id", "hymnId", "cantorId", "audioUrl", "active", "mode"]
    }
  },
  "auth": {
    "providers": ["anonymous"]
  },
  "firestore": {
    "structure": [
      {
        "path": "/genres/{genreId}",
        "definition": {
          "entityName": "HymnGenre",
          "schema": { "$ref": "#/backend/entities/HymnGenre" },
          "description": "Top-level collection for hymn genres."
        }
      },
      {
        "path": "/hymns/{hymnId}",
        "definition": {
          "entityName": "Hymn",
          "schema": { "$ref": "#/backend/entities/Hymn" },
          "description": "Top-level collection for hymns."
        }
      },
      {
        "path": "/cantors/{cantorId}",
        "definition": {
          "entityName": "Cantor",
          "schema": { "$ref": "#/backend/entities/Cantor" },
          "description": "Top-level collection for cantors."
        }
      },
      {
        "path": "/recordings/{recordingId}",
        "definition": {
          "entityName": "HymnRecording",
          "schema": { "$ref": "#/backend/entities/HymnRecording" },
          "description": "Top-level collection for hymn recordings."
        }
      }
    ],
    "reasoning": "The application uses a flat collection structure for better flexibility and easier querying across relationships."
  }
}
